rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{rsvpId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /wishes/{wishId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /gallery_images/{imageId} {
      allow read, create, update, delete: if true;
    }
  }
}
